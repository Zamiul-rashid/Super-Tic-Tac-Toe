{
  "engines": {
    "codingame-legend": {
      "source": "Place a verified Legend bot executable or wrapper at engines/bin/codingame-legend",
      "command": ["engines/bin/codingame-legend"],
      "protocol": "codingame",
      "timeout": 5.0,
      "fallback": "raise"
    },
    "utttai": {
      "source": "https://github.com/arnowaczynski/utttai",
      "command": ["{python}", "-m", "sttt.utttai_wrapper", "--simulations", "{simulations}", "--seed", "{seed}"],
      "cwd": "..",
      "protocol": "state_json",
      "timeout": 5.0,
      "fallback": "raise"
    }
  }
}
